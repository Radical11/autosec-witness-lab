    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "typescript": "^5.7.3",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
